# Copy to .env.ubuntu on the Ubuntu server, then replace placeholders.
IMAGE_TAG=local
BIND_IP=127.0.0.1
HOST_PORT=8019
APP_MEMORY_LIMIT=768m

# Database name is appdb in this example; schema name is learning_hub.
DB_URL=jdbc:postgresql://DB_HOST:5432/appdb?sslmode=require&currentSchema=learning_hub
DB_USER=dev_user
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
JWT_SECRET=CHANGE_ME_USE_OPENSSL_RAND_BASE64_64
CORS_ALLOWED_ORIGINS=https://FRONTEND_DOMAIN

# Leave all three empty if the admin account already exists or is not needed.
APP_BOOTSTRAP_ADMIN_ID=
APP_BOOTSTRAP_ADMIN_USER=
APP_BOOTSTRAP_ADMIN_PASSWORD=
