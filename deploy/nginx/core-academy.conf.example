# Optional reverse proxy on the Ubuntu host.
# Replace backend.example.com with the real backend domain.
server {
    listen 80;
    server_name backend.example.com;

    # One-time tickets are query parameters: do not access-log the socket URI.
    location = /api/v1/chat-room/socket {
        access_log off;
        proxy_pass http://127.0.0.1:8019;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 75s;
    }

    # Chunked upload parts: 8 MiB payload, 10 MiB request ceiling.
    location ~ "^/api/v1/learning-assets/uploads/[0-9a-fA-F-]+/parts/[1-9][0-9]*$" {
        client_max_body_size 10m;
        proxy_request_buffering off;
        proxy_pass http://127.0.0.1:8019;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
    }

    location / {
        proxy_pass http://127.0.0.1:8019;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 5s;
        proxy_read_timeout 60s;
    }
}
