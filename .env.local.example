# Local stack: copy to .env.local (git-ignored) and replace every change-me.
# Load it with: set -a; . ./.env.local; set +a
# Plain KEY=value lines: no quotes, no spaces, no '&' (the file is read by Spring, Docker Compose and the shell).
# Values in the environment win over .env, so the shared-DB .env keeps working for everyone else.

# PostgreSQL (docker compose `db` service)
DB_URL=jdbc:postgresql://localhost:5432/core_academy?currentSchema=learning_hub
DB_USER=core_academy
DB_PASSWORD=change-me

# Backend
JWT_SECRET=change-me-to-a-random-string-of-at-least-32-characters
SWAGGER_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:4200
SERVER_PORT=8019
SERVER_ADDRESS=127.0.0.1

# S3: MinIO from compose.local.yaml. The backend uses the bucket-scoped user, never the root account.
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=academy-media
S3_REGION=us-east-1
S3_PATH_STYLE_ACCESS=true
S3_ACCESS_KEY=academy-backend
S3_SECRET_KEY=change-me-s3-secret
S3_ROOT_USER=minio-root
S3_ROOT_PASSWORD=change-me-s3-root

# Password of the seeded demo accounts, read by scripts/local-smoke.sh and scripts/local-seed-media.sh.
# Take it from docs/sql/README.md ("Đăng nhập demo").
LOCAL_DEMO_PASSWORD=change-me

# Background workers stay off (their defaults); no Ollama or external service is needed.
